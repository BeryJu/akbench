# More info: https://docs.docker.com/engine/reference/builder/#dockerignore-file
# Ignore everything by default and re-include only needed files
**

# Re-include Go source files (but not *_test.go)
!**/*.go
**/*_test.go

# Re-include Go module files
!go.mod
!go.sum

# Re-include k6 scripts embedded via go:embed (see k6/scripts/embed.go)
!k6/scripts/*.ts

# Re-include Grafana dashboards embedded via go:embed (see internal/render/grafana.go)
!internal/render/manifests/grafana-dashboards/*.json

# Re-include the web UI's sources for Dockerfile.apiserver's frontend stage
# (but never a local node_modules or build output)
!web/ui/**
web/ui/node_modules
web/ui/dist
