# Build the web API binary - mirrors Dockerfile (the operator manager's own
# image) except for which package it builds. Deployed in-cluster so the new
# Headlamp plugin can reach it through Headlamp's own ApiProxy -> the
# standard Kubernetes Service-proxy subresource (see
# web/headlamp-plugin/src), replacing the old web/frontend Next.js server's
# direct-to-browser proxy route.
FROM golang:1.26 AS builder
ARG TARGETOS
ARG TARGETARCH

WORKDIR /workspace
COPY go.mod go.mod
COPY go.sum go.sum
RUN go mod download

COPY . .

RUN CGO_ENABLED=0 GOOS=${TARGETOS:-linux} GOARCH=${TARGETARCH} go build -a -o apiserver ./cmd/apiserver

FROM gcr.io/distroless/static:nonroot
WORKDIR /
COPY --from=builder /workspace/apiserver .
USER 65532:65532

ENTRYPOINT ["/apiserver"]
